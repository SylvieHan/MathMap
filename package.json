{
  "name": "mathmap",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:site": "VITE_PUBLISHED_SITE=true vite",
    "prebuild": "tsx scripts/export-bundled-map.ts",
    "build": "tsc -b && vite build",
    "build:site": "VITE_PUBLISHED_SITE=true npm run build",
    "build:pages": "VITE_PUBLISHED_SITE=true GITHUB_PAGES=true VITE_BASE_PATH=/MathMap/ npm run build",
    "deploy": "npm run build:pages && gh-pages -d dist -m \"Deploy MathMap site\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "example-map": "node scripts/build-example-map.mjs"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "d3-force": "^3.0.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "tsx": "^4.20.3",
    "vite": "^8.0.12"
  }
}
